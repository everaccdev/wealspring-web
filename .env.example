# Wealspring's Firebase web config (the wealspring project, never Whisp's).
# Same values as the app's .env (EXPO_PUBLIC_FIREBASE_*). These are public —
# they ship to the browser on /auth/action — but they still go in Netlify ›
# Site configuration › Environment variables, not in git.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=

# Stripe — the Eyes Wide Wellness account shared with Whisp
# (dashboard.stripe.com → Developers → API keys). Server-side only.
# A restricted key (rk_test_… in the sandbox, rk_live_… in production).
# Prices are found by their lookup keys (src/lib/catalog.ts), so no price IDs
# are set here.
STRIPE_SECRET_KEY=rk_test_...
