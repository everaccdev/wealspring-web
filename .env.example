# Wealspring's Firebase web config (the wealspring project, never Whisp's).
# Same values as the app's .env (EXPO_PUBLIC_FIREBASE_*). These are public —
# they ship to the browser on /auth/action — but they still go in Netlify ›
# Site configuration › Environment variables, not in git.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=

# Stripe — the Eyes Wide Wellness account shared with Whisp
# (dashboard.stripe.com → Developers → API keys). Server-side only.
STRIPE_SECRET_KEY=sk_live_...
# The two founders subscription Prices (Products → Wealspring Founders).
STRIPE_FOUNDERS_MONTHLY_PRICE=price_...
STRIPE_FOUNDERS_ANNUAL_PRICE=price_...
# The Whisp + Wealspring founders bundle (Products → Whisp + Wealspring Founders).
STRIPE_BUNDLE_MONTHLY_PRICE=price_...
STRIPE_BUNDLE_ANNUAL_PRICE=price_...
