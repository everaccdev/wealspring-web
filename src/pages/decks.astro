---
// Decks: the six launch decks (free for everyone) and the expansions for sale
// (lib/catalog EXPANSIONS). Prices come from Stripe; a deck whose price can't
// be read is shown without a Buy button rather than with a wrong price.
export const prerender = false;
import Base from '../layouts/Base.astro';
import { FREE_DECKS, EXPANSIONS } from '../lib/catalog';
import { priceLabel } from '../lib/stripe';

const forSale = await Promise.all(EXPANSIONS.map(async (e) => ({ ...e, price: await priceLabel(e.lookupKey) })));
---

<Base title="Decks — Wealspring" description="Every Wealspring deck: six free traditions, and expansions to add.">
  <section class="decks">
    <div class="container">
      <span class="section-label">Decks</span>
      <h1>Every <em>tradition</em>.</h1>
      <p class="lead">Six decks come free with Wealspring. More decks and expansions add traditions to draw from; an expansion joins the deck it belongs to.</p>

      <h2 class="group">Free for everyone</h2>
      <div class="grid">
        {FREE_DECKS.map((d) => (
          <article class="deck">
            <img src={d.cover} alt="" loading="lazy" width="240" height="398" />
            <h3>{d.name}</h3>
            <p>{d.subtitle} · {d.cards} cards</p>
            <span class="tag">Included</span>
          </article>
        ))}
      </div>

      {[
        { title: 'More decks', items: forSale.filter((d) => !d.parent) },
        { title: 'Expansions', items: forSale.filter((d) => d.parent) },
      ].filter((g) => g.items.length > 0).map((g) => (
        <>
          <h2 class="group">{g.title}</h2>
          <div class="grid">
            {g.items.map((d) => (
              <article class="deck">
                <img src={d.cover} alt="" loading="lazy" width="240" height="398" />
                <h3>{d.name}</h3>
                <p>{d.parent ? `For ${d.parent.name} · ` : ''}{d.subtitle} · {d.cards} cards</p>
                {d.includedWithFounders && <span class="tag">Included for founders</span>}
                {d.price && (
                  <button type="button" class="btn btn-outline buy" data-deck={d.id}>
                    Buy · {d.price.amount}
                  </button>
                )}
              </article>
            ))}
          </div>
        </>
      ))}
      {forSale.length === 0 && <p class="dim">The first expansions are on their way.</p>}
    </div>
  </section>

</Base>

<script>
  // Buy opens Stripe's checkout, which asks for the email; the deck goes to
  // the Wealspring account with that email (a new one if there isn't one).
  document.querySelectorAll<HTMLButtonElement>('.buy').forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Opening checkout…';
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kind: 'deck', deckId: btn.dataset.deck }),
        });
        const data = await res.json();
        if (data.url) { location.href = data.url; return; }
        alert(data.message || 'Checkout couldn’t start. Please try again.');
      } catch {
        alert('Network error. Check your connection and try again.');
      }
      btn.disabled = false;
      btn.textContent = label;
    });
  });
</script>

<style>
  .decks { padding: 160px 0 40px; }
  .decks h1 { font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 300; margin: 16px 0 12px; }
  .decks h1 em { font-style: italic; color: var(--gold-light); }
  .group { font-size: 1.6rem; color: var(--cream); margin: 56px 0 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 32px 24px; }
  .deck { display: flex; flex-direction: column; gap: 6px; }
  .deck img { width: 100%; height: auto; aspect-ratio: 973 / 1616; object-fit: cover; border-radius: 10px; border: 1px solid rgba(234, 193, 124, 0.35); margin-bottom: 8px; }
  .deck h3 { font-size: 1.25rem; color: var(--cream); }
  .deck p { font-size: 0.85rem; color: var(--cream-dim); line-height: 1.5; }
  .tag { align-self: flex-start; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); }
  .buy { margin-top: 8px; justify-content: center; padding: 10px 16px; }
  .buy:disabled { opacity: 0.6; cursor: default; }
</style>
