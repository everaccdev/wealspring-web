---
export const prerender = true;
import MinimalLayout from '../../layouts/MinimalLayout.astro';
---

<MinimalLayout title="Your new deck — Wealspring">
  <section class="success">
    <a href="/"><img src="/logo.svg" alt="Wealspring" width="180" height="60" class="logo" /></a>
    <span class="section-label">✦ Payment confirmed</span>
    <h1>Your deck is <em>on its way</em>.</h1>
    <p class="lead">It’s added to the Wealspring account with the email you used at checkout.</p>
    <p class="dim">Open Wealspring and sign in with that email; the deck appears in Decks within a minute. New to Wealspring? An email with a link to set your password is on its way.</p>
  </section>
</MinimalLayout>

<style>
  .success { max-width: 560px; margin: 0 auto; padding: 80px 24px; display: flex; flex-direction: column; gap: 18px; }
  .logo { height: 56px; width: auto; margin-bottom: 24px; }
  h1 { font-size: clamp(2.4rem, 7vw, 3.4rem); font-weight: 300; }
  h1 em { font-style: italic; color: var(--gold-light); }
</style>
