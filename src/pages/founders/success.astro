---
// After a founders checkout. The account is set up by Wealspring's
// stripeWebhook: an existing account (same email, or the uid it came with)
// is upgraded; otherwise one is created and a link to set its password is
// emailed (handled on /auth/action).
export const prerender = true;
import MinimalLayout from '../../layouts/MinimalLayout.astro';
---

<MinimalLayout title="Welcome, Founder — Wealspring">
  <section class="success">
    <a href="/"><img src="/logo.svg" alt="Wealspring" width="180" height="60" class="logo" /></a>
    <span class="section-label">✦ Payment confirmed</span>
    <h1>Welcome,<br /><em>Founder.</em></h1>
    <p class="lead">Your founders place is yours. Here’s how to begin.</p>
    <p class="bundle-note" id="bundle-note" hidden>
      You chose <strong>Wealspring + Whisp</strong>: premium is on in both apps, for the account with your checkout email in each.
      If you’re new to either app, you’ll get a separate email from each with a link to set your password.
    </p>
    <ol class="steps">
      <li>
        <h2>Already use Wealspring?</h2>
        <p>Sign in with the email you used at checkout. Your founders access is already on your account.</p>
      </li>
      <li>
        <h2>New to Wealspring?</h2>
        <p>An email with a link to set your password is on its way. If it hasn’t arrived in a few minutes, check your spam folder.</p>
      </li>
      <li>
        <h2>Then draw your first card.</h2>
        <p>Open Wealspring on your iPhone and sign in with the same email.</p>
      </li>
    </ol>
  </section>
</MinimalLayout>

<script>
  if (new URLSearchParams(location.search).get('bundle') === '1') {
    document.getElementById('bundle-note')!.hidden = false;
  }
</script>

<style>
  .bundle-note { color: var(--cream-dim); border-left: 2px solid rgba(206, 166, 54, 0.5); padding-left: 14px; }
  .bundle-note strong { color: var(--cream); font-weight: 500; }
  .success { max-width: 560px; margin: 0 auto; padding: 80px 24px; display: flex; flex-direction: column; gap: 18px; }
  .logo { height: 56px; width: auto; margin-bottom: 24px; }
  h1 { font-size: clamp(2.6rem, 8vw, 3.6rem); font-weight: 300; }
  h1 em { font-style: italic; color: var(--gold-light); }
  .steps { list-style: none; display: flex; flex-direction: column; gap: 22px; margin-top: 12px; counter-reset: step; }
  .steps li { counter-increment: step; padding-left: 44px; position: relative; }
  .steps li::before {
    content: counter(step); position: absolute; left: 0; top: 2px; width: 28px; height: 28px; border-radius: 50%;
    border: 1px solid rgba(206, 166, 54, 0.5); color: var(--gold-light); display: grid; place-items: center; font-size: 0.85rem;
  }
  .steps h2 { font-size: 1.3rem; color: var(--cream); }
  .steps p { color: var(--cream-dim); }
</style>
